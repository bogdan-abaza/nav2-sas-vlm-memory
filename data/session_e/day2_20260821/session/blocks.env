# blocuri.env — v2, 20 august 2026 (amendament A10)
# Se face `source` o singura data la inceputul fiecarui bloc.
#
#   source blocuri.env E3        # E0 E1 E2 E3 E4.0 E4.1 E4.3 E5 E6 E7
#
# Fata de v1: adaugate profilurile E0, E6, E7, care ieri se exportau manual.
# blocuri.env este unealta de teren, NU sistemul masurat. src/ ramane la f973aa0.

export PROTOCOL_VERSION="E-2026-09"

: "${XPLORER_PLATFORM_ID:?exporta XPLORER_PLATFORM_ID pe fiecare robot}"

unset EXPERIMENT_PHASE CONC_GROUP
export CONC_PEERS=1

case "${1:-}" in
  E0)   export EXPERIMENT_ID=E0 ;;
  E1)   export EXPERIMENT_ID=E1 ;;
  E2)   export EXPERIMENT_ID=E2 ;;
  E3)   export EXPERIMENT_ID=E3 ;;
  E4.0) export EXPERIMENT_ID=E4 EXPERIMENT_PHASE=E4.0 ;;
  E4.1) export EXPERIMENT_ID=E4 EXPERIMENT_PHASE=E4.1 ;;
  E4.3) export EXPERIMENT_ID=E4 EXPERIMENT_PHASE=E4.3 ;;
  E5)   export EXPERIMENT_ID=E5 CONC_PEERS=2
        echo "  E5: exporta si CONC_GROUP=E5-pair1|pair2|pair3 inainte de fiecare pereche" ;;
  E7)   export EXPERIMENT_ID=E7 ;;

  E6)   # ablatia M3 — refuza daca digestul gol nu e pregatit si valid
        if [ -z "${MEMORY_DIGEST_PATH:-}" ]; then
          echo "  E6 BLOCAT: exporta intai MEMORY_DIGEST_PATH catre digestul GOL."
          echo "  ex: export MEMORY_DIGEST_PATH=\$HOME/digest_gol/memory_digest.json"
          return 2 2>/dev/null || exit 2
        fi
        if [ ! -f "$MEMORY_DIGEST_PATH" ]; then
          echo "  E6 BLOCAT: $MEMORY_DIGEST_PATH nu exista."
          return 2 2>/dev/null || exit 2
        fi
        _np=$(python3 -c "import json,sys;print(len(json.load(open(sys.argv[1])).get('l3a_promotions_ready') or []))" "$MEMORY_DIGEST_PATH" 2>/dev/null)
        if [ "$_np" != "0" ]; then
          echo "  E6 BLOCAT: digestul are $_np promovari, trebuie 0. Nu e digestul gol."
          unset _np; return 2 2>/dev/null || exit 2
        fi
        unset _np
        export EXPERIMENT_ID=E6
        echo "  E6: digest GOL confirmat (0 promovari) -> $MEMORY_DIGEST_PATH"
        echo "  DUPA bloc: unset MEMORY_DIGEST_PATH si verifica md5 97241265..." ;;

  *)    echo "  utilizare: source blocuri.env {E0|E1|E2|E3|E4.0|E4.1|E4.3|E5|E6|E7}"
        return 2 2>/dev/null || exit 2 ;;
esac

if [ "${EXPERIMENT_ID}" != "E6" ] && [ -n "${MEMORY_DIGEST_PATH:-}" ]; then
  echo "  ATENTIE: MEMORY_DIGEST_PATH este inca setat ($MEMORY_DIGEST_PATH)."
  echo "  Daca vii dupa E6, ruleaza 'unset MEMORY_DIGEST_PATH' INAINTE de a porni acest bloc."
fi

echo "  bloc ${EXPERIMENT_ID}${EXPERIMENT_PHASE:+ / $EXPERIMENT_PHASE} pe ${XPLORER_PLATFORM_ID}"
